# ─────────────────────────────────────────────────────────────────────────────
# MediSpring Backend — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (REQUIRED) ──────────────────────────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:yourpassword@localhost:3306/medispring"

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── JWT Secrets (REQUIRED — change these to long random strings!) ────────────
JWT_SECRET=change_this_to_a_random_64_char_string_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_to_a_different_random_64_char_string
JWT_REFRESH_EXPIRES_IN=7d

# ── Frontend URL (for CORS) ───────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Email (optional — for password reset emails) ─────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="MediSpring <noreply@medispring.com>"

# ── File uploads ─────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=src/uploads

# ── Logging (optional) ───────────────────────────────────────────────────────
# LOG_QUERIES=true   # Uncomment to log all SQL queries (very verbose)
