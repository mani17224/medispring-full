// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DOCTOR
  RECEPTIONIST
  LABORATORY_STAFF
  PHARMACIST
  PATIENT
}

enum AppointmentStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  INSURANCE
  BANK_TRANSFER
}

enum LabTestStatus {
  PENDING
  SAMPLE_COLLECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BedStatus {
  FREE
  OCCUPIED
  CLEANING
  MAINTENANCE
  RESERVED
}

enum WardType {
  ICU
  GENERAL
  MATERNITY
  PEDIATRIC
  SURGERY
  EMERGENCY
  PRIVATE
}

enum NotificationType {
  APPOINTMENT
  BILLING
  LAB_RESULT
  EMERGENCY
  SYSTEM
  GENERAL
}

enum DoctorStatus {
  AVAILABLE
  ON_CALL
  IN_SURGERY
  ON_LEAVE
  INACTIVE
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id            Int       @id @default(autoincrement())
  firstName     String    @map("first_name") @db.VarChar(100)
  lastName      String    @map("last_name") @db.VarChar(100)
  email         String    @unique @db.VarChar(255)
  password      String    @db.VarChar(255)
  phone         String?   @db.VarChar(20)
  role          Role      @default(PATIENT)
  profileImage  String?   @map("profile_image") @db.VarChar(500)
  isActive      Boolean   @default(true) @map("is_active")
  refreshToken  String?   @map("refresh_token") @db.Text
  resetToken    String?   @map("reset_token") @db.VarChar(255)
  resetTokenExp DateTime? @map("reset_token_exp")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  doctor        Doctor?
  patient       Patient?
  notifications Notification[]

  @@map("users")
}

model Doctor {
  id             Int          @id @default(autoincrement())
  userId         Int          @unique @map("user_id")
  name           String       @db.VarChar(200)
  specialization String       @db.VarChar(100)
  qualification  String?      @db.VarChar(255)
  experience     Int          @default(0) // years
  phone          String?      @db.VarChar(20)
  email          String       @db.VarChar(255)
  consultationFee Decimal     @map("consultation_fee") @db.Decimal(10, 2)
  availability   String?      @db.VarChar(100) // e.g. "Mon-Fri"
  rating         Decimal      @default(0.0) @db.Decimal(3, 1)
  image          String?      @db.VarChar(500)
  status         DoctorStatus @default(AVAILABLE)
  bio            String?      @db.Text
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments   Appointment[]
  labTests       LabTest[]

  @@index([specialization])
  @@index([status])
  @@map("doctors")
}

model Patient {
  id               Int       @id @default(autoincrement())
  userId           Int?      @unique @map("user_id")
  patientId        String    @unique @map("patient_id") @db.VarChar(20) // e.g. PT-1042
  firstName        String    @map("first_name") @db.VarChar(100)
  lastName         String    @map("last_name") @db.VarChar(100)
  gender           String    @db.VarChar(10)
  dateOfBirth      DateTime? @map("date_of_birth")
  age              Int?
  bloodGroup       String?   @map("blood_group") @db.VarChar(5)
  phone            String    @db.VarChar(20)
  email            String?   @db.VarChar(255)
  address          String?   @db.Text
  emergencyContact String?   @map("emergency_contact") @db.VarChar(20)
  medicalHistory   String?   @map("medical_history") @db.Text
  currentCondition String?   @map("current_condition") @db.VarChar(255)
  riskLevel        RiskLevel @default(LOW) @map("risk_level")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user             User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments     Appointment[]
  bills            Bill[]
  labTests         LabTest[]
  beds             Bed[]

  @@index([patientId])
  @@index([riskLevel])
  @@map("patients")
}

model Appointment {
  id              Int               @id @default(autoincrement())
  patientId       Int               @map("patient_id")
  doctorId        Int               @map("doctor_id")
  appointmentDate DateTime          @map("appointment_date") @db.Date
  appointmentTime String            @map("appointment_time") @db.VarChar(10) // "10:30"
  reason          String?           @db.VarChar(500)
  status          AppointmentStatus @default(SCHEDULED)
  notes           String?           @db.Text
  roomNumber      String?           @map("room_number") @db.VarChar(20)
  tokenNumber     String?           @map("token_number") @db.VarChar(10)
  isTelemedicine  Boolean           @default(false) @map("is_telemedicine")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  patient         Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor          Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  bill            Bill?

  @@index([patientId])
  @@index([doctorId])
  @@index([appointmentDate])
  @@index([status])
  @@map("appointments")
}

model Bill {
  id              Int           @id @default(autoincrement())
  invoiceNumber   String        @unique @map("invoice_number") @db.VarChar(20) // INV-2048
  patientId       Int           @map("patient_id")
  appointmentId   Int?          @unique @map("appointment_id")
  amount          Decimal       @db.Decimal(10, 2)
  discount        Decimal       @default(0.00) @db.Decimal(10, 2)
  tax             Decimal       @default(0.00) @db.Decimal(10, 2)
  totalAmount     Decimal       @map("total_amount") @db.Decimal(10, 2)
  paymentMethod   PaymentMethod @default(CASH) @map("payment_method")
  paymentStatus   PaymentStatus @default(PENDING) @map("payment_status")
  dueDate         DateTime?     @map("due_date")
  paidAt          DateTime?     @map("paid_at")
  notes           String?       @db.Text
  items           Json?         // Array of billing line items
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  patient         Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment     Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([paymentStatus])
  @@index([invoiceNumber])
  @@map("bills")
}

model LabTest {
  id           Int          @id @default(autoincrement())
  patientId    Int          @map("patient_id")
  doctorId     Int?         @map("doctor_id")
  testName     String       @map("test_name") @db.VarChar(255)
  testCategory String?      @map("test_category") @db.VarChar(100)
  testResult   String?      @map("test_result") @db.Text
  normalRange  String?      @map("normal_range") @db.VarChar(100)
  isCritical   Boolean      @default(false) @map("is_critical")
  reportFile   String?      @map("report_file") @db.VarChar(500)
  status       LabTestStatus @default(PENDING)
  scheduledAt  DateTime?    @map("scheduled_at")
  completedAt  DateTime?    @map("completed_at")
  notes        String?      @db.Text
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor       Doctor?      @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([status])
  @@index([isCritical])
  @@map("lab_tests")
}

model Ward {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  type      WardType
  capacity  Int
  floor     String?  @db.VarChar(20)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  beds      Bed[]

  @@map("wards")
}

model Bed {
  id           Int       @id @default(autoincrement())
  bedNumber    String    @unique @map("bed_number") @db.VarChar(20)
  wardId       Int       @map("ward_id")
  patientId    Int?      @map("patient_id")
  status       BedStatus @default(FREE)
  assignedDate DateTime? @map("assigned_date")
  dischargeDate DateTime? @map("discharge_date")
  notes        String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  ward         Ward      @relation(fields: [wardId], references: [id], onDelete: Cascade)
  patient      Patient?  @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([wardId])
  @@index([status])
  @@map("beds")
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int?             @map("user_id")
  title     String           @db.VarChar(255)
  message   String           @db.Text
  type      NotificationType @default(GENERAL)
  isRead    Boolean          @default(false) @map("is_read")
  metadata  Json?            // Extra data (e.g. patient id, appointment id)
  createdAt DateTime         @default(now()) @map("created_at")

  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}
